generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  adminId       String?
  createdAt     DateTime       @default(now())
  department    String?
  depot         String
  location      String
  managerId     String?
  password      String
  phone         String?
  role          Role           @default(USER)
  fcm_token     String?
  otps          Otp[]
  RefreshToken  RefreshToken[]
  userRequests  Request[]      @relation("UserToRequests")
  availedBlocks Request[]      @relation("AvailedByUser")
  requestRejects Request[]      @relation("RejectedByUser")
  admin         User?          @relation("AdminToManagers", fields: [adminId], references: [id])
  managers      User[]         @relation("AdminToManagers")
  manager       User?          @relation("ManagerToUsers", fields: [managerId], references: [id])
  manages       User[]         @relation("ManagerToUsers")

  @@index([email])
  @@index([role])
}

model Request {
  id                                String     @id @default(uuid())
  divisionId                        String?    @unique
  date                              DateTime
  freshCautions                      Json?
  selectedDepartment                String
  selectedSection                   String
  stationID                         String?
  missionBlock                      String
  workType                          String
  activity                          String?
  freshCautionRequired              Boolean?   @default(false)
  freshCautionSpeed                 Int?
  freshCautionLocationFrom          String?
  freshCautionLocationTo            String?
  adjacentLinesAffected             String?
  workLocationFrom                  String?
  workLocationTo                    String?
  demandTimeFrom                    DateTime
  demandTimeTo                      DateTime
  sigDisconnection                  Boolean?   @default(false)
  elementarySection                 String?
  elementarySectionTo               String?
  sigElementarySectionFrom          String?
  sigElementarySectionTo            String?
  repercussions                     String?
  trdWorkLocation                   String?
  requestremarks                    String?
  createdAt                         DateTime   @default(now())
  status                            String?    @default("PENDING")
  selectedDepo                      String?
  sigResponse                       String?    @default("yes")
  ohDisconnection                   String?
  oheDisconnection                  String?
  oheResponse                       String?    @default("yes")
  corridorType                      String?    @default("corridor")
  corridorTypeSelection             String?
  sigActionsNeeded                  Boolean?   @default(true)
  trdActionsNeeded                  Boolean?   @default(true)
  ManagerResponse                   String?
  managerResponseTiming             DateTime?
  sigDisconnectionRequirements      String?
  sntDisconnectionRequirements      Json?
  sntDisconnectionLine              String?
  sntDisconnectionLineFrom          String?
  sntDisconnectionLineTo            String?
  trdDisconnectionRequirements      String?
  powerBlockRequirements            Json?
  powerBlockRequired                Boolean?   @default(false)
  sntDisconnectionRequired          Boolean?   @default(false)
  processedLineSections             Json?
  routeFrom                         String?
  routeTo                           String?
  DisconnAcceptance                 Acceptance @default(PENDING)
  userId                            String?
  managerAcceptanceId               String?
  managerAcceptance                 Boolean    @default(false)
  adminAcceptanceId                 String?
  adminAcceptance                   Boolean    @default(true)
  adminRequestStatus                String?    @default("PENDING")
  availedResponse                   String?
  disconnectionRequestRejectRemarks String?
  isSanctioned                      Boolean?   @default(false)
  optimizeStatus                    Boolean    @default(false)
  optimizeTimeFrom                  DateTime?
  optimizeTimeTo                    DateTime?
  reasonForReject                   String?
  remarkByManager                   String?
  sanctionedTimeFrom                DateTime?
  sanctionedTimeTo                  DateTime?
  AvailedTimeFrom                   DateTime?
  AvailedTimeTo                     DateTime?
  SntDisconnectionAvailedTimeFrom   DateTime?
  SntDisconnectionAvailedTimeTo     DateTime?
  TrdDisconnectionAvailedTimeFrom   DateTime?
  TrdDisconnectionAvailedTimeTo     DateTime?
  isGranted                         Boolean?   @default(false)
  availedRemarks                    String?
  sntDisconnectionAssignTo          String?
  trdDisconnectionAssignTo          String?
  powerBlockDisconnectionAssignTo   String?
  userResponse                      String?
  userAcceptanceForSanction         Boolean    @default(false)
  userStatus                        String?
  workNature                        String?
  grantedFromTime                   DateTime?
  grantedToTime                     DateTime?
  availedById                       String?
  user                              User?                @relation("UserToRequests", fields: [userId], references: [id])
  availedBy                         User?                @relation("AvailedByUser", fields: [availedById], references: [id])
  rejectedById                     String?
  rejectedBy                         User?                @relation("RejectedByUser", fields: [rejectedById], references: [id])
  sntDisconnections                 SntDisconnection[]   
  trdDisconnections                 TrdDisconnection[]
  enggDisconnections                EnggDisconnection[]
  allSntAcceptance                  Acceptance?   @default(PENDING)
  allTrdAcceptance                  Acceptance?   @default(PENDING)
  allEnggAcceptance                 Acceptance?   @default(PENDING)
 enggDisconnectionsRequired         Boolean?     @default(false)
 engDisconnectionAssignTo           String?
 engDisconnectionRemarks            String?
  overAllStatus                     String?
  emergencyBlockRemarks             String?
  sanctionedRemarks                 String?
  sntAcceptRemarks                  String?
  trdAcceptRemarks                  String?
  duration                          DateTime?
  isApplied                         Boolean?
  AppliedTimeFrom                   DateTime?
  AppliedTimeTo                     DateTime?
  engDisconnectionRequired          Boolean?   @default(false)
  tpcRemarks                        String?
  Draft                             Boolean?   @default(false)
  blockBurst                        Boolean?   @default(false)
  assetName                         String?
  assetNumber                       String?

  @@index([userId])
  @@index([managerAcceptanceId])
  @@index([adminAcceptanceId])
  @@index([createdAt])
}

model Optimize_Table {
  id                 String   @id @default(uuid())
  optimizeTimeFrom   DateTime
  optimizeTimeTo     DateTime
  date               DateTime
  missionBlock       String
  otherAffectedLine  String
  selectedDepartment String
  selectedDepo       String
  selectedLine       String
  selectedSection    String
  selectedStream     String
  isEdited           Boolean? @default(false)
}

model Otp {
  id        String   @id @default(uuid())
  code      String
  phone     String?
  createdAt DateTime @default(now())
  validTill DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([validTill])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  USER
  JUNIOR_OFFICER
  SENIOR_OFFICER
  BRANCH_OFFICER
  ADMIN
  SUPER_ADMIN
  PUNCTUALITY_CONTROLLER
  DEPT_CONTROLLER
  DRM
  HQ
  JE
  SM
  BOARD_CONTROLLER
}

enum Acceptance {
  PENDING
  ACCEPTED
  REJECTED
}

//New model for Train Arrival Update

model TrainArrival {
  id                String    @id @default(uuid())
  majorSection      String
  referenceStation  String
  trainNumber       String
  arrivalTime       String
  arrivedOrNot      Boolean   @default(false)
  arrivedTime       DateTime?
  affectingStations String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([referenceStation, trainNumber])
}

model SntDisconnection {
  id          String   @id @default(uuid())
  requestId   String
  depot       String
  status      String    @default("PENDING")
  remarks     String?
  approvedAt  DateTime?

  request     Request   @relation(fields: [requestId], references: [id])
}

model TrdDisconnection {
  id          String   @id @default(uuid())
  requestId   String
  depot       String
  status      String    @default("PENDING")
  remarks     String?
  approvedAt  DateTime?

  request     Request   @relation(fields: [requestId], references: [id])
}
model EnggDisconnection {
  id          String   @id @default(uuid())
  requestId   String
  depot       String
  status      String    @default("PENDING")
  remarks     String?
  approvedAt  DateTime?

  request     Request   @relation(fields: [requestId], references: [id])
}