{
    "version": 2,
    "builds": [
        {
            "src": "src/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/src/server.js"
        }
    ],
    "buildCommand": "cd src && npm install && npm run prisma:generate",
    "env": {
        "NODE_ENV": "production"
    }
}
